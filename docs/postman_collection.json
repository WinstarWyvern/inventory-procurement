{
  "info": {
    "name": "Inventory Procurement API (Java / Spring Boot)",
    "description": "Backend Technical Test - Inventory Procurement API (Java 17 + Spring Boot 3 + PostgreSQL version). Import together with the Inventory Procurement - Local (Spring Boot) environment.",
