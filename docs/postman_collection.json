    {
      "name": "Purchase Requests",
      "item": [
        {
          "name": "Create Purchase Request",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.data && body.data.id) pm.collectionVariables.set('purchaseRequestId', body.data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/purchase-requests",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"warehouseId\": {{warehouseId}},\n  \"items\": [\n    { \"productId\": {{productId}}, \"quantity\": 100 },\n    { \"productId\": {{secondProductId}}, \"quantity\": 50 }\n  ]\n}"
            }
          }
        },
        {
          "name": "List Purchase Requests",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": "{{baseUrl}}/purchase-requests"
          }
        },
        {
          "name": "List Purchase Requests (filter by status)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": "{{baseUrl}}/purchase-requests?status=SUBMITTED"
          }
        },
        {
          "name": "Get Purchase Request Detail",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": "{{baseUrl}}/purchase-requests/{{purchaseRequestId}}"
          }
        },
        {
          "name": "Update Draft (change warehouse)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/purchase-requests/{{purchaseRequestId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"warehouseId\": {{warehouseId}}\n}"
            }
          }
        },
        {
          "name": "Add Item to Draft",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/purchase-requests/{{purchaseRequestId}}/items",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": {{secondProductId}},\n  \"quantity\": 20\n}"
            }
          }
        },
        {
          "name": "Update Item Quantity",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/purchase-requests/{{purchaseRequestId}}/items/1",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 30\n}"
            }
          }
        },
        {
          "name": "Remove Item",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": "{{baseUrl}}/purchase-requests/{{purchaseRequestId}}/items/1"
          }
        },
        {
          "name": "Submit Purchase Request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": "{{baseUrl}}/purchase-requests/{{purchaseRequestId}}/submit"
          }
        },
        {
          "name": "Approve Purchase Request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{approverToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/purchase-requests/{{purchaseRequestId}}/approve",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"remarks\": \"Approved - budget available\"\n}"
            }
          }
        },
        {
          "name": "Reject Purchase Request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{approverToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/purchase-requests/{{purchaseRequestId}}/reject",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"remarks\": \"Not needed this quarter\"\n}"
            }
          }
        }
      ]
